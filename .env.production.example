# 文件用途：生产部署变量模板。复制为 .env.production 后填写；不要提交真实值。
COMPOSE_PROJECT_NAME=knowledge-agent-production

# 必须是已经解析到服务器的域名。涉密系统应使用单位批准的内网域名。
APP_DOMAIN=agent.example.internal
ACME_EMAIL=ops@example.com

# 只使用随机十六进制字符串，避免数据库连接串中的特殊字符转义问题。
MYSQL_PASSWORD=替换为至少32字节随机十六进制字符串
MYSQL_ROOT_PASSWORD=替换为至少32字节随机十六进制字符串
REDIS_PASSWORD=替换为至少32字节随机十六进制字符串
RAG_CACHE_REDIS_PASSWORD=替换为至少32字节随机十六进制字符串
SECRET_KEY=替换为至少32字节随机十六进制字符串
CONTROL_PLANE_AUTH_SECRET=替换为至少32字节随机十六进制字符串
CONTROL_PLANE_INTERNAL_TOKEN=替换为至少32字节随机十六进制字符串

# 第一次启动时创建管理员。密码至少 12 位，只保存在服务器的 .env.production 中。
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=替换为管理员强密码

# 大模型配置。密钥只能保存在服务器，不得写入仓库或前端。
LLM_API_KEY=填写经过单位批准的大模型密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

SESSION_COOKIE_SECURE=true
ALLOW_PUBLIC_REGISTRATION=false
RAG_CACHE_MAXMEMORY=128mb
VITE_API_TIMEOUT=30000
