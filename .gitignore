# 文件用途：公开代码仓库忽略规则；只提交源代码、架构、部署说明和测试。

# 编辑器和操作系统文件
/.idea/
/.vscode/
.DS_Store
**/.DS_Store

# Python、Go、Node.js 生成文件
__pycache__/
**/__pycache__/
*.py[cod]
/.pytest_cache/
/.venv/
/.venv-*/
/web/frontend/node_modules/
/web/frontend/dist/
/coverage/

# 本地运行数据、实验数据、模型、知识资料和日志
/data/
/img/
/model_ckp/
/logs/
/rag_knowledge_base/
/instance/
/feature_sel/
/runs/
/upload_test/
*.log
*.sqlite
*.sqlite3
*.db

# 本地归档、压缩包和个人材料
/Trash/
/docs/interview/
/docs/resume/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# 真实环境变量和运行时秘密；只允许提交不含真实值的示例模板
.env
.env.*
!.env.example
!.env.docker.example
!.env.production.example
/web/frontend/.env
/web/frontend/.env.*
!/web/frontend/.env.example
/.run/

# 私钥和证书容器
*.pem
*.key
*.p12
*.pfx

# 生产演示目录只保留空目录标记和公开说明
/deploy/demo/data/*
!/deploy/demo/data/.gitkeep
/deploy/demo/logs/*
!/deploy/demo/logs/.gitkeep
/deploy/demo/model_ckp/*
!/deploy/demo/model_ckp/.gitkeep
