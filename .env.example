# DeepSeek / OpenAI-compatible API
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
AGENT_MAX_STEPS=20

# RAG（本地神经 Embedding + OpenSearch BM25/HNSW + RRF + 神经 Reranker）
RAG_CORPUS_PATH=rag_knowledge_base
RAG_INDEX_PATH=instance/rag_index.sqlite
# OpenSearch handles first-stage BM25 + HNSW recall. SQLite keeps provenance,
# parent chunks, claims, entities, and the knowledge graph.
RAG_SEARCH_BACKEND=opensearch
RAG_OPENSEARCH_URL=http://localhost:9200
RAG_OPENSEARCH_INDEX=knowledge-rag
RAG_OPENSEARCH_TIMEOUT_SECONDS=10
RAG_OPENSEARCH_VERIFY_TLS=true
RAG_OPENSEARCH_SHARDS=1
RAG_OPENSEARCH_REPLICAS=0
RAG_OPENSEARCH_BULK_SIZE=200
RAG_RETRIEVAL_CANDIDATES=100
RAG_HNSW_M=16
RAG_HNSW_EF_CONSTRUCTION=100
RAG_EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_DIMENSION=512
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_MAX_LENGTH=512
RAG_MODEL_LOCAL_FILES_ONLY=true
RAG_CHUNK_MAX_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=180
RAG_EMBEDDING_BATCH_SIZE=32
# Use a cache-only Redis with an eviction policy; omit to disable caching.
RAG_CACHE_REDIS_URL=redis://localhost:6380/0
RAG_SEARCH_CACHE_TTL_SECONDS=300
RAG_SEARCH_CACHE_LOCK_SECONDS=60
RAG_SEARCH_CACHE_WAIT_SECONDS=1
RAG_EMBEDDING_CACHE_TTL_SECONDS=2592000
RAG_CACHE_TTL_JITTER_SECONDS=60
RAG_CACHE_FAILURE_BACKOFF_SECONDS=5
RAG_SEARCH_CACHE_VERSION=v1
DATASET_QUALITY_CACHE_TTL_SECONDS=600
RAG_FUSION_QUERY_COUNT=4
RAG_TOTAL_QUERY_LIMIT=8
RAG_FUSION_ORIGINAL_QUERY_WEIGHT=2.0
RAG_QUERY_EXPANSION_ENABLED=true
RAG_QUERY_EXPANSION_PROVIDER=llm
RAG_QUERY_PLANNER_PROVIDER=llm
RAG_QUERY_PLANNER_TIMEOUT_SECONDS=30
RAG_COMPLEX_QUERY_MIN_CHARS=80
# 使用大模型生成多查询时改为 llm；默认复用 LLM 配置
# RAG_QUERY_EXPANSION_PROVIDER=llm
# RAG_QUERY_EXPANSION_API_KEY=
# RAG_QUERY_EXPANSION_BASE_URL=https://api.deepseek.com
# RAG_QUERY_EXPANSION_MODEL=deepseek-chat
RAG_RERANKER_PROVIDER=huggingface
RAG_RERANK_CANDIDATES=15
RAG_RERANK_WEIGHT=1.5
RAG_MMR_LAMBDA=0.75
RAG_CLAIM_NOVELTY_WEIGHT=0.002
RAG_ENTITY_COVERAGE_WEIGHT=0.008
RAG_REQUIRED_CLAIM_WEIGHT=0.01
RAG_ROLE_COVERAGE_WEIGHT=0.006
RAG_SUBQUERY_RESERVE_POOL=5
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_ENTITY_LINK_THRESHOLD=0.58
RAG_EVIDENCE_ASSESSOR=llm
# RAG_EVIDENCE_API_KEY=（默认复用 LLM_API_KEY）
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_MAX_LENGTH=512
RAG_RERANKER_BATCH_SIZE=8
# 接入兼容 /rerank 接口的神经精排服务时改为 http
# RAG_RERANKER_PROVIDER=http
# RAG_RERANKER_URL=
# RAG_RERANKER_API_KEY=
# RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_OCR_ENABLED=true
RAG_OCR_MIN_TEXT_CHARS=40
RAG_OCR_LANGUAGES=chi_sim+eng
RAG_OCR_DPI=240
RAG_OCR_TIMEOUT_SECONDS=90
# RAG_TESSERACT_COMMAND=tesseract
# 切换 OpenAI-compatible Embedding 时填写：
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# RAG_EMBEDDING_DIMENSION=1536

# Local read-only MCP server identity (set this in the MCP host process config)
MCP_USER_ID=1

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_DEDUP_REDIS_URL=redis://localhost:6379/1
CELERY_DEDUP_LOCK_TTL_SECONDS=90
CELERY_VISIBILITY_TIMEOUT=172800
CELERY_RESULT_EXPIRES=86400

# Flask and MySQL
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/embedded_software
SESSION_COOKIE_SECURE=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false

# Go control plane (local process; Compose supplies its own service hosts)
CONTROL_PLANE_DATABASE_DSN=knowledge:password@tcp(127.0.0.1:3306)/embedded_software?parseTime=true&charset=utf8mb4
CONTROL_PLANE_AUTH_SECRET=replace-with-at-least-16-characters
CONTROL_PLANE_INTERNAL_TOKEN=replace-with-at-least-16-characters
CONTROL_PLANE_ADDR=:8081
CONTROL_PLANE_URL=http://127.0.0.1:8081
PYTHON_AGENT_GRPC_TARGET=127.0.0.1:50051
AGENT_GRPC_ADDRESS=0.0.0.0:50051
AGENT_GRPC_MAX_WORKERS=8

# Independent Go Gin experiment platform
BUSINESS_DATABASE_DSN=knowledge:password@tcp(127.0.0.1:3306)/embedded_software?parseTime=true&charset=utf8mb4
BUSINESS_API_ADDR=:8080
BUSINESS_PYTHON_TIMEOUT=15s
AI_HTTP_URL=http://127.0.0.1:5001
FRONTEND_ORIGIN=http://localhost:5173
BUSINESS_DATA_ROOT=./data
BUSINESS_LOG_ROOT=./logs
BUSINESS_CONFIG_ROOT=./configs
REDIS_URL=redis://:password@127.0.0.1:6379/0
REDIS_LOCK_TTL=90s
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=agent-events
CONTROL_PLANE_WORKER_CONCURRENCY=4
CONTROL_PLANE_PYTHON_TIMEOUT=90s
CONTROL_PLANE_RUN_LEASE=90s
CONTROL_PLANE_WORKER_RUN_TIMEOUT=10m

# Metadata-backed knowledge graph expansion (entity -> document -> claim)
RAG_GRAPH_ENABLED=true
RAG_GRAPH_CANDIDATES=6

# Docker Compose infrastructure and frontend
MYSQL_PASSWORD=knowledge-dev-password
MYSQL_ROOT_PASSWORD=knowledge-root-password
REDIS_PASSWORD=knowledge-redis-password
RAG_CACHE_REDIS_PASSWORD=knowledge-cache-password
RAG_CACHE_MAXMEMORY=256mb
VITE_API_BASE_URL=http://localhost:8080
VITE_API_TIMEOUT=30000
